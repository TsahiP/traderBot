# Copy to .env and fill in. Never commit .env.

# Alpaca paper trading (live bot + dashboard account). Do not use live keys.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Bybit spot candles for tickers ending in -USD (BTC-USD -> BTCUSDT). Market data only.
BYBIT_API_KEY=
BYBIT_SECRET_KEY=

# Optional local LLM (LM Studio) — backtest advisor + Discord analyst bot
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=

# Fundamentals + news (fundabot.py / dashboard Fundi tab) — all free tiers,
# all optional; missing keys just drop that provider from the fallback chain.
# Signups: financialmodelingprep.com (250/day), finnhub.io (60/min) — get both first.
FMP_API_KEY=
FINNHUB_API_KEY=
# alphavantage.co (25/day, 5/min) — used sparingly (sentiment news, last-resort fields).
# Both spellings are accepted: ALPHAVANTAGE_API_KEY or ALPHA_VANTAGE_API_KEY.
ALPHAVANTAGE_API_KEY=
# twelvedata.com (800 credits/day) — price fallback only.
TWELVEDATA_API_KEY=
# Keyless sources need no keys: SEC EDGAR (statements), Google News RSS,
# CoinGecko market data + CoinDesk/Cointelegraph/Decrypt RSS (crypto news).

# Signal bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord — bot sync (Signals tab: Sync from Discord; maps stock-1h / crypto-5m channel names)
# DISCORD_TOKEN (already used by some setups) is accepted as a fallback for DISCORD_BOT_TOKEN.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Discord — analyst room (analystbot.py: users pick a ticker from a select menu,
# fill in an optional position popup, the bot gathers all data + chart images,
# runs the 5-step analysis through the local LLM and posts it there).
# The channel is created + locked (no free typing) automatically. Optional overrides:
# DISCORD_ANALYST_CHANNEL=fundi-analyst
# ANALYST_COOLDOWN_S=20
# ANALYST_NEWS_MAX=6
# ANALYST_SIGNALS_MAX=8
# ANALYST_RISK_USD=250          # step-5 default dollar risk per trade
# ANALYST_ACCOUNT_USD=0         # >0: step-5 size also capped at 25% of this account
# TIMEMACHINE_ALERT_RUNS=2000   # Monte Carlo line on intraday stock alerts (0 = off)
# ANALYST_REASONING_EFFORT=none  # LM Studio reasoning_effort for analyst calls; empty = server default
# ANALYST_REPLY_MODE=dm         # dm = send the analysis privately (falls back to the channel if DMs are closed); channel = post publicly
# ANALYST_TARGET_RR=3           # reward:risk for the fixed-ratio plan (invest-amount field)
# ANALYST_VISION=1              # 0 disables sending chart images to the model
# MACRO_TTL_MIN=10              # market-context cache lifetime in minutes
# Discord — legacy stock trade rooms (still used as fallbacks)
DISCORD_WEBHOOK_DAY_TRADE=
DISCORD_WEBHOOK_HOUR_TRADE=
DISCORD_WEBHOOK_MINUTE_TRADE=
DISCORD_WEBHOOK_WEEK_TRADE=
# Discord — per-timeframe stock webhooks (optional; fall back to legacy above)
DISCORD_WEBHOOK_STOCK_1M=
DISCORD_WEBHOOK_STOCK_5M=
DISCORD_WEBHOOK_STOCK_15M=
DISCORD_WEBHOOK_STOCK_30M=
DISCORD_WEBHOOK_STOCK_1H=
DISCORD_WEBHOOK_STOCK_1D=
DISCORD_WEBHOOK_STOCK_1W=
# Discord — crypto webhooks (one channel per timeframe)
DISCORD_WEBHOOK_CRYPTO_1M=
DISCORD_WEBHOOK_CRYPTO_5M=
DISCORD_WEBHOOK_CRYPTO_15M=
DISCORD_WEBHOOK_CRYPTO_30M=
DISCORD_WEBHOOK_CRYPTO_1H=
DISCORD_WEBHOOK_CRYPTO_1D=
DISCORD_WEBHOOK_CRYPTO_1W=
# Discord — news (manual / future automation)
DISCORD_WEBHOOK_STOCK_NEWS=
DISCORD_WEBHOOK_CRYPTO_NEWS=
# Paper desk (paperbot.py): entries, exits, proposals, errors - in its own room. Or create a #paperbot channel and Sync from Discord.
DISCORD_WEBHOOK_PAPER=
# fundabot news summaries: read each article from its link and summarize it with LM Studio
# before posting to Discord (falls back to the plain headline if the page/LLM fails).
# NEWS_LLM_SUMMARY=1            # 0 = plain headlines only
# NEWS_LLM_MODEL=               # empty = same model as LLM_MODEL / auto-pick (a different one makes LM Studio swap models)
# NEWS_SUMMARY_LANG=Hebrew
# ANALYST_EXTRA_SYMBOLS=META,AMZN   # extra stock tickers for the Discord select menu only (no scanning / news polling)
